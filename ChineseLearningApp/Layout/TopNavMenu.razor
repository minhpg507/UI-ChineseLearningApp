    </div>
    @* ========================================== *@
    @* MODAL ĐĂNG NHẬP / ĐĂNG KÝ                  *@
    @* ========================================== *@
    @if (showLoginModal)
    {
        <div class="modal fade show d-block" style="background: rgba(0,0,0,0.6); z-index: 1050;">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">

                    <div class="modal-header border-0 pb-0 pt-4 px-4 position-relative">
                        <h4 class="modal-title fw-bold w-100 text-center">Đăng nhập</h4>
                        <button type="button" class="btn-close position-absolute" style="right: 20px; top: 20px;" @onclick="CloseLoginModal"></button>
                    </div>

                    <div class="modal-body p-4 pt-3">
                        <p class="text-center text-muted small mb-4">Chào mừng bạn quay lại! Hãy đăng nhập để lưu trữ tiến độ học tập.</p>

                        <button class="btn w-100 mb-3 d-flex align-items-center justify-content-center gap-2 fw-bold"
                                style="border: 1px solid #e2e8f0; border-radius: 12px; height: 48px; background-color: white; color: #334155; transition: all 0.2s;">
                            <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google" style="width: 24px; height: 24px;" />
                            Tiếp tục với Google
                        </button>

                        <button class="btn w-100 mb-4 d-flex align-items-center justify-content-center gap-2 fw-bold text-white"
                                style="border: none; border-radius: 12px; height: 48px; background-color: #1877f2; transition: all 0.2s;">
                            <img src="https://www.svgrepo.com/show/448224/facebook.svg" alt="Facebook" style="width: 24px; height: 24px; filter: brightness(0) invert(1);" />
                            Tiếp tục với Facebook
                        </button>

                        <div class="d-flex align-items-center mb-4">
                            <hr class="flex-grow-1 m-0">
                            <span class="mx-3 text-muted small fw-bold">HOẶC EMAIL</span>
                            <hr class="flex-grow-1 m-0">
                        </div>

                        <div class="mb-3">
                            <input type="email" class="form-control" placeholder="Email của bạn" style="border-radius: 10px; padding: 12px 16px; background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        </div>
                        <div class="mb-4">
                            <input type="password" class="form-control" placeholder="Mật khẩu" style="border-radius: 10px; padding: 12px 16px; background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        </div>

                        <button class="btn w-100 fw-bold text-white mb-3" style="background-color: #00a8ff; border-radius: 10px; height: 48px;">
                            Đăng nhập
                        </button>

                        <div class="text-center">
                            <a href="#" class="text-decoration-none small fw-bold" style="color: #00a8ff;">Quên mật khẩu?</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    }

@code {
    private bool showLoginModal = false;

    private void OpenLoginModal()
    {
        showLoginModal = true;
    }

    private void CloseLoginModal()
    {
        showLoginModal = false;
    }
}
@code {
    // Biến lưu trạng thái đóng/mở của bảng Avatar
    private bool showAvatarMenu = false;

    // Hàm đảo ngược trạng thái (đang mở thì đóng, đang đóng thì mở)
    private void ToggleAvatarMenu()
    {
        showAvatarMenu = !showAvatarMenu;
    }

    // Hàm ép buộc đóng menu (dùng khi click ra ngoài màn hình hoặc chuyển trang)
    private void CloseMenu()
    {
        showAvatarMenu = false;
    }
}
</nav>